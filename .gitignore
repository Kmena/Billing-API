# SDD specifications — intentionally local-only, never committed
# All SDD specification packages, planning documents and SDD implementation
# artifacts are local to the developer's machine and must not be versioned.
specs/

# Documentation
# Project-level documentation under docs/ is version-controlled.
# Ignore only generated, temporary, sensitive or local-only documentation below.
# docs/audit/drafts/     ← example: uncomment to ignore draft audit files only

# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
*.local.env

# Certificates and private keys — NEVER commit
*.p12
*.pfx
*.key
*.pem
*.crt

# Signed fiscal documents — contain real fiscal data; must never be committed
SIGNED_*.xml
storage/

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jest coverage
coverage/

# Prisma
prisma/dev.db

# Temporary files
*.tmp
*.temp

# TypeScript incremental build
*.tsbuildinfo
