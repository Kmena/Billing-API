# ─────────────────────────────────────────────────────────────────────────────
# Billing — Environment Variables Example
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# All variables listed here are validated by the Joi schema in
# src/infrastructure/config/config.validation-schema.ts
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database (required in all environments) ───────────────────────────────────
DATABASE_URL=postgresql://billing:billing_password@localhost:5432/billing_dev

# ── Authentication ────────────────────────────────────────────────────────────
# In production this MUST be a strong random secret >= 32 chars (from SecretProvider)
JWT_SECRET=dev-insecure-jwt-secret-change-in-production-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local | s3
STORAGE_TYPE=local

# For local storage (development only — do NOT use in production):
LOCAL_STORAGE_PATH=./storage
# WARNING: change this secret in any environment that is not strictly local
LOCAL_STORAGE_SECRET=local-signing-secret-dev-only

# For S3 / LocalStack:
# AWS_S3_BUCKET=billing-documents-dev
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── Secret Management ─────────────────────────────────────────────────────────
# Options: env | ssm
SECRET_PROVIDER=env
# For SSM (production):
# SSM_PARAMETER_PREFIX=/billing/prod
# AWS_REGION=us-east-1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: wildcard (*) is allowed and is the default.
# Production / Staging: MUST be set to an explicit origin — the app will refuse
# to start if this is absent or set to '*' when NODE_ENV=production or staging.
# Example (comma-separated for multiple origins):
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# @nestjs/throttler v6 uses milliseconds for TTL
THROTTLE_API_TTL=60000
THROTTLE_API_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10

# ── Hacienda Integration ──────────────────────────────────────────────────────
# Set USE_REAL_HACIENDA=true to call the real Hacienda API (requires network access)
USE_REAL_HACIENDA=false
HACIENDA_API_BASE_URL=https://api.hacienda.go.cr
HACIENDA_TIMEOUT_MS=10000

# ── Hacienda Cache TTLs (milliseconds) ───────────────────────────────────────
TAXPAYER_CACHE_TTL_MS=3600000       # 1 hour
EXCHANGE_RATE_CACHE_TTL_MS=14400000 # 4 hours
CABYS_ITEM_CACHE_TTL_MS=86400000    # 24 hours
CABYS_SEARCH_CACHE_TTL_MS=3600000   # 1 hour

# ── Hacienda Resilience — Circuit Breaker ─────────────────────────────────────
# Defaults are production-safe. Adjust only if you understand the implications.
# HACIENDA_CB_FAILURE_THRESHOLD: open circuit after N consecutive failures (default: 5)
HACIENDA_CB_FAILURE_THRESHOLD=5
# HACIENDA_CB_RESET_TIMEOUT_MS: wait this long before testing connection (default: 30s)
HACIENDA_CB_RESET_TIMEOUT_MS=30000
# HACIENDA_CB_OUTBOUND_RATE_PER_SECOND: max requests/s to Hacienda (max allowed: 10)
HACIENDA_CB_OUTBOUND_RATE_PER_SECOND=8

# ── Hacienda Resilience — Retry ───────────────────────────────────────────────
# HACIENDA_RETRY_429_COUNT: max retry attempts on HTTP 429 (default: 2)
HACIENDA_RETRY_429_COUNT=2
# HACIENDA_RETRY_429_BASE_DELAY_MS: base delay for linear backoff on 429 (default: 1000ms)
HACIENDA_RETRY_429_BASE_DELAY_MS=1000
# HACIENDA_RETRY_5XX_COUNT: max retry attempts on 5xx/network errors (default: 1)
HACIENDA_RETRY_5XX_COUNT=1
# HACIENDA_RETRY_5XX_DELAY_MS: fixed delay before retrying 5xx (default: 2000ms)
HACIENDA_RETRY_5XX_DELAY_MS=2000

# ── Hacienda private IDP authentication (Fase 2.1) ───────────────────────────
# ROPC request sends grant_type, client_id, username and password only. No scope.
HACIENDA_IDP_PRODUCTION_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/token
HACIENDA_IDP_SANDBOX_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token
HACIENDA_IDP_CLIENT_ID_PRODUCTION=api-prod
HACIENDA_IDP_CLIENT_ID_SANDBOX=api-stag
HACIENDA_AUTH_TIMEOUT_MS=10000
HACIENDA_AUTH_TOKEN_EXPIRY_SAFETY_MARGIN_MS=30000
HACIENDA_AUTH_RETRY_5XX_COUNT=1
HACIENDA_AUTH_RETRY_5XX_DELAY_MS=2000
# Production SSM uses the ECS Task Role or EC2 Instance Profile. Never add static AWS keys here.

# ── Hacienda CE Reception (Fase 3/4-S) ───────────────────────────────────────
# Repository default below is the OFFICIAL_PUBLISHED_CONTRACT_VALUE.
# For F4-S sandbox validation, override to the PRIMARY_RUNTIME_CANDIDATE:
#   HACIENDA_RECEPCION_SANDBOX_BASE_URL=https://api-sandbox.comprobanteselectronicos.go.cr/recepcion/v1
# The safety guard will REJECT the repository default during F4-S execution.
HACIENDA_RECEPCION_PRODUCTION_BASE_URL=https://api.comprobanteselectronicos.go.cr/recepcion/v1/
HACIENDA_RECEPCION_SANDBOX_BASE_URL=https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/
HACIENDA_SUBMISSION_TIMEOUT_MS=15000
# HACIENDA_SUBMISSION_CALLBACK_URL=https://your-server/api/v1/hacienda/callback

# ── F4-S Hacienda Sandbox Validation ─────────────────────────────────────────
# These variables are ONLY needed when running: npm run test:hacienda-sandbox
# NEVER set real values in .env.local.example — only variable names are listed here.
# Set real values in your shell session or a gitignored local file.
# The .secrets/ and secrets-local/ directories are gitignored — use them for .p12 files.
#
# SECURITY: All F4-S secrets must be set at runtime only. Never commit real values.
#
# Override reception URL for F4-S (PRIMARY_RUNTIME_CANDIDATE):
# HACIENDA_RECEPCION_SANDBOX_BASE_URL=https://api-sandbox.comprobanteselectronicos.go.cr/recepcion/v1
#
# Enable real Hacienda adapters (required for F4-S live execution):
# USE_REAL_HACIENDA=true
#
# Sandbox credentials (NEVER commit real values):
# F4S_SANDBOX_USERNAME=<set at runtime>
# F4S_SANDBOX_PASSWORD=<set at runtime>
#
# PKCS#12 certificate path (must be in .secrets/ or secrets-local/ — gitignored):
# F4S_SANDBOX_CERT_PATH=.secrets/hacienda-sandbox.p12
#
# Certificate PIN (NEVER commit):
# F4S_SANDBOX_CERT_PIN=<set at runtime>
#
# Sandbox issuer profile:
# F4S_COMPANY_ID=<UUID of sandbox company>
# F4S_TENANT_ID=<UUID of sandbox tenant>
#
# Evidence output path (gitignored directory):
# F4S_EVIDENCE_PATH=test-output/hacienda-sandbox
