# ─────────────────────────────────────────────────────────────────────────────
# Billing — Environment Variables Example
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database (required in all environments) ───────────────────────────────────
DATABASE_URL=postgresql://billing:billing_password@localhost:5432/billing_dev

# ── Authentication ────────────────────────────────────────────────────────────
# In production this MUST be a strong random secret >= 32 chars (from SecretProvider)
JWT_SECRET=dev-insecure-jwt-secret-change-in-production-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local | s3
STORAGE_TYPE=local
# For local storage, files are stored in: ./storage (relative to project root)
LOCAL_STORAGE_PATH=./storage

# For S3 / LocalStack:
# AWS_S3_BUCKET=billing-documents-dev
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── Secret Management ─────────────────────────────────────────────────────────
# Options: env | ssm
SECRET_PROVIDER=env
# For SSM (production):
# SSM_PARAMETER_PREFIX=/billing/prod
# AWS_REGION=us-east-1
