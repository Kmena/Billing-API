{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/helpers/e2e-database-global-setup.cjs",
  "setupFiles": ["<rootDir>/helpers/e2e-database-guard.setup.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "module": "CommonJS", "moduleResolution": "Node", "allowJs": true } }]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/cache-manager|cache-manager|@nestjs/axios)/)"
  ],
  "moduleNameMapper": {
    "^@nestjs/cache-manager$": "<rootDir>/helpers/nest-cache-manager.cjs",
    "^@/modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@/infrastructure/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@/api/(.*)$": "<rootDir>/../src/api/$1"
  },
  "maxWorkers": 1,
  "testTimeout": 60000
}
