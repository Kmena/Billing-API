{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(w1-d0-contracts|\\.contract)\\.spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "transformIgnorePatterns": ["node_modules/(?!(@nestjs/cache-manager|cache-manager|@nestjs/axios)/)"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
