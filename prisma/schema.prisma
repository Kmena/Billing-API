// ─── Prisma Schema — Billing ────────────────────────────────────────────────
// Fase 0: Foundation
// Schema version: 1.1 (ADR-009: event_class field in audit_logs)
// Do NOT modify this file without creating a new migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum UserRole {
  TENANT_ADMIN
  MEMBER
  READ_ONLY
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum IdentificationType {
  FISICA // 01 – Cédula física (CR)
  JURIDICA // 02 – Cédula jurídica (CR)
  DIMEX // 03 – DIMEX (extranjeros residentes)
  NITE // 04 – NITE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiKeyEnv {
  LIVE
  TEST
}

// Fase 1: Hacienda verification outcome for company creation
enum HaciendaVerificationStatus {
  VERIFIED // Taxpayer found and confirmed in Hacienda
  NOT_FOUND // Hacienda returned not-found (body code=404)
  UNAVAILABLE // HTTP 429, timeout, or transient 5xx from Hacienda
  ERROR // Unexpected / unclassified failure
  SKIPPED // Verification intentionally skipped (reserved for future use)
}

// ADR-009: Three-level audit retention classification
enum EventClass {
  FISCAL_AUDIT // >= 5 years — fiscal lifecycle traceability
  TECHNICAL // configurable — general operational events
  SECURITY // configurable — security-related events
}

enum HaciendaConnectionStatus {
  NOT_CONFIGURED
  PENDING_VALIDATION
  CONNECTED
  INVALID_CREDENTIALS
  UNAVAILABLE
  DISABLED
}

enum HaciendaEnvironment {
  PRODUCTION
  SANDBOX
}

enum FiscalDocumentType {
  INVOICE
  TICKET
}

enum FiscalDocumentStatus {
  READY_FOR_XML
  XML_GENERATED
  XML_VALIDATED
  SIGNED
  READY_TO_SUBMIT
  ACCEPTED
  REJECTED
}

enum FiscalSubmissionStatus {
  REQUESTED
  QUEUED
  SUBMITTING
  POST_OUTCOME_UNKNOWN
  ACKNOWLEDGED
  PROCESSING
  ACCEPTED
  REJECTED
  TECHNICAL_RETRY_PENDING
  MANUAL_REVIEW_REQUIRED
}

enum FiscalXmlValidationStatus {
  NOT_VALIDATED
  VALID
  INVALID
}

enum FiscalSigningCertificateStatus {
  ACTIVE
  DISABLED
  EXPIRED
  REPLACED
  INVALID
}

enum FiscalSigningCertificateType {
  HACIENDA_CRYPTOGRAPHIC_KEY
  LEGAL_DIGITAL_SIGNATURE
}

enum FiscalIdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// ─── F4 ENUMS ───────────────────────────────────────────────────────────────

enum FiscalArtifactType {
  SIGNED_XML
  HACIENDA_RESPONSE_XML
  PDF
}

enum DocumentDeliveryKind {
  INITIAL_DOCUMENT
  HACIENDA_RESPONSE
}

enum DocumentDeliveryChannel {
  EMAIL
}

enum DocumentDeliveryStatus {
  PENDING
  QUEUED
  SENDING
  DELIVERED
  RETRY_PENDING
  FAILED
  MANUAL_REVIEW_REQUIRED
  CANCELLED
}

// ─── TENANT ─────────────────────────────────────────────────────────────────

model Tenant {
  id                        String                     @id @db.Uuid
  name                      String                     @db.VarChar(255)
  slug                      String                     @unique @db.VarChar(100)
  status                    TenantStatus               @default(ACTIVE)
  plan                      TenantPlan                 @default(TRIAL)
  metadata                  Json?
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  companies                 Company[]
  users                     User[]
  apiKeys                   ApiKey[]
  auditLogs                 AuditLog[]
  haciendaConnections       HaciendaConnection[]
  fiscalIssuancePoints      FiscalIssuancePoint[]
  fiscalSequences           FiscalSequence[]
  fiscalDocuments           FiscalDocument[]
  fiscalIdempotencyKeys     FiscalIdempotencyKey[]
  fiscalSigningCertificates FiscalSigningCertificate[]
  fiscalXmlArtifacts        FiscalXmlArtifact[]
  fiscalSubmissions         FiscalSubmission[]
  companyFiscalProfiles     CompanyFiscalProfile[]
  fiscalArtifacts           FiscalArtifact[]
  documentDeliveries        DocumentDelivery[]

  @@map("tenants")
}

// ─── COMPANY ────────────────────────────────────────────────────────────────

model Company {
  id                         String                      @id @db.Uuid
  tenantId                   String                      @map("tenant_id") @db.Uuid
  legalName                  String                      @map("legal_name") @db.VarChar(255)
  tradeName                  String?                     @map("trade_name") @db.VarChar(255)
  identificationType         IdentificationType          @map("identification_type")
  identificationNumber       String                      @map("identification_number") @db.VarChar(20)
  status                     CompanyStatus               @default(ACTIVE)
  // Fase 1: Hacienda verification fields (nullable — backward-compatible with Fase 0 records)
  haciendaName               String?                     @map("hacienda_name") @db.VarChar(255)
  haciendaVerifiedAt         DateTime?                   @map("hacienda_verified_at")
  haciendaVerificationStatus HaciendaVerificationStatus? @map("hacienda_verification_status")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  authorizedApiKeys          ApiKeyCompany[]
  haciendaConnections        HaciendaConnection[]
  fiscalIssuancePoints       FiscalIssuancePoint[]
  fiscalSequences            FiscalSequence[]
  fiscalDocuments            FiscalDocument[]
  fiscalIdempotencyKeys      FiscalIdempotencyKey[]
  fiscalSigningCertificates  FiscalSigningCertificate[]
  fiscalXmlArtifacts         FiscalXmlArtifact[]
  fiscalSubmissions          FiscalSubmission[]
  fiscalProfile              CompanyFiscalProfile?
  companyPdfSettings         CompanyPdfSettings?
  fiscalArtifacts            FiscalArtifact[]
  documentDeliveries         DocumentDelivery[]

  @@unique([tenantId, identificationNumber])
  @@index([tenantId, status])
  @@map("companies")
}

model CompanyFiscalProfile {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  economicActivityCode String   @map("economic_activity_code") @db.VarChar(6)
  proveedorSistemas    String?  @map("proveedor_sistemas") @db.VarChar(20)
  province             String   @db.Char(1)
  canton               String   @db.Char(2)
  district             String   @db.Char(2)
  barrio               String?  @db.VarChar(50)
  otrasSenas           String   @map("otras_senas") @db.VarChar(250)
  email                String   @db.VarChar(160)
  phoneCountryCode     String?  @map("phone_country_code") @db.VarChar(3)
  phoneNumber          String?  @map("phone_number") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  company              Company  @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId])
  @@index([tenantId])
  @@map("company_fiscal_profiles")
}

model FiscalIssuancePoint {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  environment  HaciendaEnvironment @map("environment")
  branchCode   String              @map("branch_code") @db.Char(3)
  terminalCode String              @map("terminal_code") @db.Char(5)
  name         String?             @db.VarChar(120)
  active       Boolean             @default(true)
  isDefault    Boolean             @default(false) @map("is_default")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  company      Company             @relation(fields: [companyId], references: [id])
  documents    FiscalDocument[]

  @@unique([companyId, environment, branchCode, terminalCode])
  @@index([tenantId, companyId, environment, active])
  @@map("fiscal_issuance_points")
}

model FiscalSequence {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  environment  HaciendaEnvironment @map("environment")
  branchCode   String              @map("branch_code") @db.Char(3)
  terminalCode String              @map("terminal_code") @db.Char(5)
  documentType FiscalDocumentType  @map("document_type")
  nextValue    BigInt              @map("next_value")
  lastAssigned BigInt?             @map("last_assigned")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  company      Company             @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, environment, branchCode, terminalCode, documentType])
  @@index([tenantId, companyId, environment])
  @@map("fiscal_sequences")
}

model FiscalDocument {
  id                 String                 @id @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  companyId          String                 @map("company_id") @db.Uuid
  environment        HaciendaEnvironment    @map("environment")
  type               FiscalDocumentType     @map("type")
  status             FiscalDocumentStatus   @default(READY_FOR_XML)
  issuancePointId    String                 @map("issuance_point_id") @db.Uuid
  branchCode         String                 @map("branch_code") @db.Char(3)
  terminalCode       String                 @map("terminal_code") @db.Char(5)
  sequenceValue      BigInt                 @map("sequence_value")
  consecutive        String                 @db.Char(20)
  clave              String                 @unique @db.Char(50)
  securityCode       String                 @map("security_code") @db.Char(8)
  situation          String                 @default("1") @db.Char(1)
  issueDate          DateTime               @default(now()) @map("issue_date")
  issuerSnapshot     Json                   @map("issuer_snapshot")
  receiverSnapshot   Json?                  @map("receiver_snapshot")
  currency           String                 @db.Char(3)
  exchangeRate       Decimal?               @map("exchange_rate") @db.Decimal(18, 5)
  saleCondition      String                 @map("sale_condition") @db.Char(2)
  paymentMethod      String                 @map("payment_method") @db.Char(2)
  lines              Json
  totals             Json
  idempotencyKey     String?                @map("idempotency_key") @db.VarChar(255)
  requestHash        String?                @map("request_hash") @db.Char(64)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  company            Company                @relation(fields: [companyId], references: [id])
  issuancePoint      FiscalIssuancePoint    @relation(fields: [issuancePointId], references: [id])
  idempotencyKeys    FiscalIdempotencyKey[]
  xmlArtifacts       FiscalXmlArtifact[]
  submission         FiscalSubmission?
  fiscalArtifacts    FiscalArtifact[]
  documentDeliveries DocumentDelivery[]

  @@unique([tenantId, companyId, environment, consecutive])
  @@index([tenantId, companyId, createdAt(sort: Desc)])
  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, idempotencyKey])
  @@map("fiscal_documents")
}

model FiscalSigningCertificate {
  id                         String                         @id @db.Uuid
  tenantId                   String                         @map("tenant_id") @db.Uuid
  companyId                  String                         @map("company_id") @db.Uuid
  environment                HaciendaEnvironment            @map("environment")
  status                     FiscalSigningCertificateStatus @default(ACTIVE)
  certificateType            FiscalSigningCertificateType   @map("certificate_type")
  certificateSecretReference String                         @map("certificate_secret_reference") @db.VarChar(500)
  passwordSecretReference    String                         @map("password_secret_reference") @db.VarChar(500)
  fingerprintSha256          String?                        @map("fingerprint_sha256") @db.Char(64)
  serialNumber               String?                        @map("serial_number") @db.VarChar(120)
  subjectName                String?                        @map("subject_name") @db.VarChar(500)
  issuerName                 String?                        @map("issuer_name") @db.VarChar(500)
  validFrom                  DateTime?                      @map("valid_from")
  validTo                    DateTime?                      @map("valid_to")
  activeFrom                 DateTime?                      @map("active_from")
  replacedById               String?                        @map("replaced_by_id") @db.Uuid
  extractedIdentityNumber    String?                        @map("extracted_identity_number") @db.VarChar(30)
  extractedIdentityType      String?                        @map("extracted_identity_type") @db.VarChar(20)
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id])
  company                    Company                        @relation(fields: [companyId], references: [id])
  replacedBy                 FiscalSigningCertificate?      @relation("FiscalSigningCertificateReplacement", fields: [replacedById], references: [id])
  replacements               FiscalSigningCertificate[]     @relation("FiscalSigningCertificateReplacement")
  xmlArtifacts               FiscalXmlArtifact[]

  @@index([tenantId, companyId, environment, status], map: "fiscal_signing_cert_scope_status_idx")
  @@index([tenantId, companyId, environment, certificateType], map: "fiscal_signing_cert_scope_type_idx")
  @@map("fiscal_signing_certificates")
}

model FiscalXmlArtifact {
  id                     String                    @id @db.Uuid
  tenantId               String                    @map("tenant_id") @db.Uuid
  companyId              String                    @map("company_id") @db.Uuid
  fiscalDocumentId       String                    @map("fiscal_document_id") @db.Uuid
  environment            HaciendaEnvironment       @map("environment")
  documentType           FiscalDocumentType        @map("document_type")
  schemaVersion          String                    @map("schema_version") @db.VarChar(20)
  xmlProfileVersion      String                    @map("xml_profile_version") @db.VarChar(40)
  unsignedXmlStorageKey  String?                   @map("unsigned_xml_storage_key") @db.VarChar(700)
  unsignedXmlSha256      String?                   @map("unsigned_xml_sha256") @db.Char(64)
  signedXmlStorageKey    String?                   @map("signed_xml_storage_key") @db.VarChar(700)
  signedXmlSha256        String?                   @map("signed_xml_sha256") @db.Char(64)
  xsdValidationStatus    FiscalXmlValidationStatus @default(NOT_VALIDATED) @map("xsd_validation_status")
  xsdValidatedAt         DateTime?                 @map("xsd_validated_at")
  xsdValidationErrors    Json?                     @map("xsd_validation_errors")
  signingCertificateId   String?                   @map("signing_certificate_id") @db.Uuid
  signatureProfile       String?                   @map("signature_profile") @db.VarChar(60)
  signatureAlgorithm     String?                   @map("signature_algorithm") @db.VarChar(120)
  digestAlgorithm        String?                   @map("digest_algorithm") @db.VarChar(120)
  canonicalizationMethod String?                   @map("canonicalization_method") @db.VarChar(120)
  signedAt               DateTime?                 @map("signed_at")
  signatureVerifiedAt    DateTime?                 @map("signature_verified_at")
  processingAttemptCount Int                       @default(0) @map("processing_attempt_count")
  lastErrorCode          String?                   @map("last_error_code") @db.VarChar(120)
  lastErrorMessage       String?                   @map("last_error_message") @db.VarChar(500)
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id])
  company                Company                   @relation(fields: [companyId], references: [id])
  fiscalDocument         FiscalDocument            @relation(fields: [fiscalDocumentId], references: [id])
  signingCertificate     FiscalSigningCertificate? @relation(fields: [signingCertificateId], references: [id])

  @@unique([tenantId, companyId, fiscalDocumentId, schemaVersion, xmlProfileVersion])
  @@index([tenantId, companyId, environment, documentType], map: "fiscal_xml_artifact_scope_type_idx")
  @@index([tenantId, companyId, xsdValidationStatus], map: "fiscal_xml_artifact_validation_idx")
  @@map("fiscal_xml_artifacts")
}

model FiscalSubmission {
  id                         String                 @id @db.Uuid
  tenantId                   String                 @map("tenant_id") @db.Uuid
  companyId                  String                 @map("company_id") @db.Uuid
  fiscalDocumentId           String                 @unique @map("fiscal_document_id") @db.Uuid
  environment                HaciendaEnvironment    @map("environment")
  documentType               FiscalDocumentType     @map("document_type")
  clave                      String                 @unique @db.Char(50)
  signedXmlSha256            String                 @map("signed_xml_sha256") @db.Char(64)
  signedXmlStorageKey        String                 @map("signed_xml_storage_key") @db.VarChar(700)
  status                     FiscalSubmissionStatus @default(REQUESTED)
  technicalStatus            String?                @map("technical_status") @db.VarChar(80)
  attemptCount               Int                    @default(0) @map("attempt_count")
  reconciliationAttemptCount Int                    @default(0) @map("reconciliation_attempt_count")
  firstSubmittedAt           DateTime?              @map("first_submitted_at")
  lastAttemptAt              DateTime?              @map("last_attempt_at")
  nextAttemptAt              DateTime?              @map("next_attempt_at")
  acceptedAt                 DateTime?              @map("accepted_at")
  rejectedAt                 DateTime?              @map("rejected_at")
  providerLocation           String?                @map("provider_location") @db.VarChar(700)
  providerReference          String?                @map("provider_reference") @db.VarChar(255)
  lastHttpStatus             Int?                   @map("last_http_status")
  lastNormalizedErrorCode    String?                @map("last_normalized_error_code") @db.VarChar(120)
  lastSanitizedErrorMessage  String?                @map("last_sanitized_error_message") @db.VarChar(500)
  lastProviderStatus         String?                @map("last_provider_status") @db.VarChar(40)
  lastProviderMetadata       Json?                  @map("last_provider_metadata")
  responseStorageKey         String?                @map("response_storage_key") @db.VarChar(700)
  responseSha256             String?                @map("response_sha256") @db.Char(64)
  responseContentType        String?                @map("response_content_type") @db.VarChar(120)
  responseReceivedAt         DateTime?              @map("response_received_at")
  version                    Int                    @default(0)
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id])
  company                    Company                @relation(fields: [companyId], references: [id])
  fiscalDocument             FiscalDocument         @relation(fields: [fiscalDocumentId], references: [id])

  @@index([tenantId, companyId, status], map: "fiscal_submission_scope_status_idx")
  @@index([status, nextAttemptAt], map: "fiscal_submission_due_work_idx")
  @@index([environment, status], map: "fiscal_submission_environment_status_idx")
  @@map("fiscal_submissions")
}

model FiscalIdempotencyKey {
  id               String                  @id @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  key              String                  @db.VarChar(255)
  apiKeyId         String?                 @map("api_key_id") @db.Uuid
  operation        String                  @db.VarChar(60)
  requestHash      String                  @map("request_hash") @db.Char(64)
  status           FiscalIdempotencyStatus @default(IN_PROGRESS)
  fiscalDocumentId String?                 @map("fiscal_document_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  company          Company                 @relation(fields: [companyId], references: [id])
  fiscalDocument   FiscalDocument?         @relation(fields: [fiscalDocumentId], references: [id])
  apiKey           ApiKey?                 @relation(fields: [apiKeyId], references: [id])

  @@unique([tenantId, companyId, apiKeyId, operation, key])
  @@map("fiscal_idempotency_keys")
}

model HaciendaConnection {
  id                      String                   @id @db.Uuid
  tenantId                String                   @map("tenant_id") @db.Uuid
  companyId               String                   @map("company_id") @db.Uuid
  environment             HaciendaEnvironment      @map("environment")
  status                  HaciendaConnectionStatus @default(NOT_CONFIGURED) @map("status")
  secretReference         String                   @map("secret_reference") @db.VarChar(500)
  lastValidatedAt         DateTime?                @map("last_validated_at")
  lastSuccessfulAuthAt    DateTime?                @map("last_successful_auth_at")
  lastValidationErrorCode String?                  @map("last_validation_error_code") @db.VarChar(100)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  company                 Company                  @relation(fields: [companyId], references: [id])

  @@unique([companyId, environment])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("hacienda_connections")
}

// ─── USER ───────────────────────────────────────────────────────────────────

model User {
  id            String         @id @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  email         String         @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  firstName     String?        @map("first_name") @db.VarChar(100)
  lastName      String?        @map("last_name") @db.VarChar(100)
  role          UserRole       @default(MEMBER)
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

// ─── API KEY ────────────────────────────────────────────────────────────────

model ApiKey {
  id                    String                 @id @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  name                  String                 @db.VarChar(255)
  environment           ApiKeyEnv              @default(LIVE) @map("environment")
  keyPrefix             String                 @unique @map("key_prefix") @db.VarChar(16)
  keyHash               String                 @map("key_hash") @db.VarChar(255)
  scopes                String[]
  status                ApiKeyStatus           @default(ACTIVE)
  expiresAt             DateTime?              @map("expires_at")
  lastUsedAt            DateTime?              @map("last_used_at")
  revokedAt             DateTime?              @map("revoked_at")
  revokedBy             String?                @map("revoked_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  companies             ApiKeyCompany[]
  auditLogs             AuditLog[]
  fiscalIdempotencyKeys FiscalIdempotencyKey[]

  @@index([tenantId, status])
  @@index([keyPrefix])
  @@map("api_keys")
}

// ─── API KEY ↔ COMPANY (N:M) ───────────────────────────────────────────────

model ApiKeyCompany {
  apiKeyId  String  @map("api_key_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  apiKey    ApiKey  @relation(fields: [apiKeyId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@id([apiKeyId, companyId])
  @@map("api_key_companies")
}

// ─── REFRESH TOKENS ────────────────────────────────────────────────────────
// Stores hashed refresh tokens. On use, old token is marked used and a new one issued.

model RefreshToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────
// append-only: no UPDATE, no DELETE — enforced at application layer
// ADR-009: eventClass classifies retention requirement

model AuditLog {
  id            String     @id @db.Uuid
  tenantId      String?    @map("tenant_id") @db.Uuid
  companyId     String?    @map("company_id") @db.Uuid
  apiKeyId      String?    @map("api_key_id") @db.Uuid
  actor         String?    @db.VarChar(255) // userId | apiKeyPrefix | "system"
  action        String     @db.VarChar(255) // "api-key.created" | "user.login"
  resource      String?    @db.VarChar(255) // "ApiKey:uuid" | "Tenant:uuid"
  endpoint      String?    @db.VarChar(500)
  httpMethod    String?    @map("http_method") @db.VarChar(10)
  statusCode    Int?       @map("status_code")
  ipAddress     String?    @map("ip_address") @db.VarChar(45)
  correlationId String?    @map("correlation_id") @db.VarChar(36)
  durationMs    Int?       @map("duration_ms")
  eventClass    EventClass @default(TECHNICAL) @map("event_class")
  metadata      Json?
  errorMessage  String?    @map("error_message")
  createdAt     DateTime   @default(now()) @map("created_at")
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  apiKey        ApiKey?    @relation(fields: [apiKeyId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([eventClass, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── F4: FISCAL ARTIFACTS ───────────────────────────────────────────────────
// FiscalArtifact: metadata index for SIGNED_XML, HACIENDA_RESPONSE_XML, PDF.
// XML artifacts reference existing F2.3/F3 storage keys (no byte duplication).
// PDF artifacts have their own storage key + template/renderer version.

model FiscalArtifact {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  fiscalDocumentId String             @map("fiscal_document_id") @db.Uuid
  type             FiscalArtifactType @map("type")
  storageKey       String             @map("storage_key") @db.VarChar(700)
  sha256           String             @db.Char(64)
  contentType      String             @map("content_type") @db.VarChar(120)
  sizeBytes        Int                @map("size_bytes")
  templateId       String?            @map("template_id") @db.VarChar(80)
  rendererVersion  String?            @map("renderer_version") @db.VarChar(40)
  supersededAt     DateTime?          @map("superseded_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  company          Company            @relation(fields: [companyId], references: [id])
  fiscalDocument   FiscalDocument     @relation(fields: [fiscalDocumentId], references: [id])

  // One active PDF artifact per document+template+rendererVersion combination
  // XML artifacts: one active per document+type (where templateId/rendererVersion are null)
  @@unique([fiscalDocumentId, type, templateId, rendererVersion], map: "fiscal_artifact_unique_pdf_idx")
  @@index([tenantId, companyId, fiscalDocumentId, type], map: "fiscal_artifact_scope_type_idx")
  @@index([tenantId, companyId, createdAt(sort: Desc)], map: "fiscal_artifact_scope_date_idx")
  @@map("fiscal_artifacts")
}

// ─── F4: COMPANY PDF SETTINGS ────────────────────────────────────────────────
// Controlled branding — no arbitrary HTML/CSS. Logo stored by reference.

model CompanyPdfSettings {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  companyId          String   @unique @map("company_id") @db.Uuid
  templateId         String   @default("BILLING_DEFAULT_V1") @map("template_id") @db.VarChar(80)
  logoStorageKey     String?  @map("logo_storage_key") @db.VarChar(700)
  logoSha256         String?  @map("logo_sha256") @db.Char(64)
  logoContentType    String?  @map("logo_content_type") @db.VarChar(60)
  primaryColor       String?  @map("primary_color") @db.VarChar(7)
  secondaryColor     String?  @map("secondary_color") @db.VarChar(7)
  footerText         String?  @map("footer_text") @db.VarChar(500)
  showCommercialName Boolean  @default(true) @map("show_commercial_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  company            Company  @relation(fields: [companyId], references: [id])

  @@index([tenantId, companyId], map: "company_pdf_settings_scope_idx")
  @@map("company_pdf_settings")
}

// ─── F4: DOCUMENT DELIVERY ───────────────────────────────────────────────────────
// Two delivery kinds per fiscal document: INITIAL_DOCUMENT and HACIENDA_RESPONSE.
// Each has an independent lifecycle and attempt history.
// DocumentDelivery.status NEVER modifies FiscalDocument.status (invariant).

model DocumentDelivery {
  id                 String                  @id @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  companyId          String                  @map("company_id") @db.Uuid
  fiscalDocumentId   String                  @map("fiscal_document_id") @db.Uuid
  kind               DocumentDeliveryKind    @map("kind")
  channel            DocumentDeliveryChannel @default(EMAIL) @map("channel")
  recipient          String                  @db.VarChar(320)
  packageVersion     String?                 @map("package_version") @db.VarChar(80)
  status             DocumentDeliveryStatus  @default(PENDING) @map("status")
  attemptCount       Int                     @default(0) @map("attempt_count")
  lastAttemptAt      DateTime?               @map("last_attempt_at")
  nextAttemptAt      DateTime?               @map("next_attempt_at")
  deliveredAt        DateTime?               @map("delivered_at")
  lastErrorCode      String?                 @map("last_error_code") @db.VarChar(120)
  lastSanitizedError String?                 @map("last_sanitized_error") @db.VarChar(500)
  providerMessageId  String?                 @map("provider_message_id") @db.VarChar(255)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  company            Company                 @relation(fields: [companyId], references: [id])
  fiscalDocument     FiscalDocument          @relation(fields: [fiscalDocumentId], references: [id])
  attempts           DeliveryAttempt[]

  // One active delivery per document+kind+channel+recipient+packageVersion.
  // Enforced by two partial indexes in migration 20260916000000_f4_fix_delivery_unique_null:
  //   document_delivery_unique_null_pkg_idx    WHERE package_version IS NULL
  //   document_delivery_unique_versioned_pkg_idx WHERE package_version IS NOT NULL
  // NOTE: @@unique is NOT used here because Prisma emits a NULL-unsafe B-tree index;
  //       PostgreSQL NULL != NULL in unique indexes, allowing duplicate rows.
  //       The partial-index pattern is the correct PostgreSQL idiom.
  @@index([tenantId, companyId, fiscalDocumentId], map: "document_delivery_scope_doc_idx")
  @@index([tenantId, companyId, status], map: "document_delivery_scope_status_idx")
  @@index([status, nextAttemptAt], map: "document_delivery_due_work_idx")
  @@map("document_deliveries")
}

// ─── F4: DELIVERY ATTEMPT ────────────────────────────────────────────────────────
// Immutable history of delivery attempts. Append-only.

model DeliveryAttempt {
  id                String           @id @db.Uuid
  deliveryId        String           @map("delivery_id") @db.Uuid
  attemptNumber     Int              @map("attempt_number")
  status            String           @db.VarChar(40)
  providerStatus    String?          @map("provider_status") @db.VarChar(80)
  errorCode         String?          @map("error_code") @db.VarChar(120)
  sanitizedError    String?          @map("sanitized_error") @db.VarChar(500)
  startedAt         DateTime         @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  providerMessageId String?          @map("provider_message_id") @db.VarChar(255)
  delivery          DocumentDelivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, attemptNumber], map: "delivery_attempt_delivery_idx")
  @@map("delivery_attempts")
}
