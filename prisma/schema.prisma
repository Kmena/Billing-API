// ─── Prisma Schema — Billing ────────────────────────────────────────────────
// Fase 0: Foundation
// Schema version: 1.1 (ADR-009: event_class field in audit_logs)
// Do NOT modify this file without creating a new migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum UserRole {
  TENANT_ADMIN
  MEMBER
  READ_ONLY
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum IdentificationType {
  FISICA // 01 – Cédula física (CR)
  JURIDICA // 02 – Cédula jurídica (CR)
  DIMEX // 03 – DIMEX (extranjeros residentes)
  NITE // 04 – NITE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiKeyEnv {
  LIVE
  TEST
}

// Fase 1: Hacienda verification outcome for company creation
enum HaciendaVerificationStatus {
  VERIFIED // Taxpayer found and confirmed in Hacienda
  NOT_FOUND // Hacienda returned not-found (body code=404)
  UNAVAILABLE // HTTP 429, timeout, or transient 5xx from Hacienda
  ERROR // Unexpected / unclassified failure
  SKIPPED // Verification intentionally skipped (reserved for future use)
}

// ADR-009: Three-level audit retention classification
enum EventClass {
  FISCAL_AUDIT // >= 5 years — fiscal lifecycle traceability
  TECHNICAL // configurable — general operational events
  SECURITY // configurable — security-related events
}

enum HaciendaConnectionStatus {
  NOT_CONFIGURED
  PENDING_VALIDATION
  CONNECTED
  INVALID_CREDENTIALS
  UNAVAILABLE
  DISABLED
}

enum HaciendaEnvironment {
  PRODUCTION
  SANDBOX
}

// ─── TENANT ─────────────────────────────────────────────────────────────────

model Tenant {
  id                  String               @id @db.Uuid
  name                String               @db.VarChar(255)
  slug                String               @unique @db.VarChar(100)
  status              TenantStatus         @default(ACTIVE)
  plan                TenantPlan           @default(TRIAL)
  metadata            Json?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  companies           Company[]
  users               User[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  haciendaConnections HaciendaConnection[]

  @@map("tenants")
}

// ─── COMPANY ────────────────────────────────────────────────────────────────

model Company {
  id                         String                      @id @db.Uuid
  tenantId                   String                      @map("tenant_id") @db.Uuid
  legalName                  String                      @map("legal_name") @db.VarChar(255)
  tradeName                  String?                     @map("trade_name") @db.VarChar(255)
  identificationType         IdentificationType          @map("identification_type")
  identificationNumber       String                      @map("identification_number") @db.VarChar(20)
  status                     CompanyStatus               @default(ACTIVE)
  // Fase 1: Hacienda verification fields (nullable — backward-compatible with Fase 0 records)
  haciendaName               String?                     @map("hacienda_name") @db.VarChar(255)
  haciendaVerifiedAt         DateTime?                   @map("hacienda_verified_at")
  haciendaVerificationStatus HaciendaVerificationStatus? @map("hacienda_verification_status")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  authorizedApiKeys          ApiKeyCompany[]
  haciendaConnections        HaciendaConnection[]

  @@unique([tenantId, identificationNumber])
  @@index([tenantId, status])
  @@map("companies")
}

model HaciendaConnection {
  id                      String                   @id @db.Uuid
  tenantId                String                   @map("tenant_id") @db.Uuid
  companyId               String                   @map("company_id") @db.Uuid
  environment             HaciendaEnvironment      @map("environment")
  status                  HaciendaConnectionStatus @default(NOT_CONFIGURED) @map("status")
  secretReference         String                   @map("secret_reference") @db.VarChar(500)
  lastValidatedAt         DateTime?                @map("last_validated_at")
  lastSuccessfulAuthAt    DateTime?                @map("last_successful_auth_at")
  lastValidationErrorCode String?                  @map("last_validation_error_code") @db.VarChar(100)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  company                 Company                  @relation(fields: [companyId], references: [id])

  @@unique([companyId, environment])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("hacienda_connections")
}

// ─── USER ───────────────────────────────────────────────────────────────────

model User {
  id            String         @id @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  email         String         @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  firstName     String?        @map("first_name") @db.VarChar(100)
  lastName      String?        @map("last_name") @db.VarChar(100)
  role          UserRole       @default(MEMBER)
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

// ─── API KEY ────────────────────────────────────────────────────────────────

model ApiKey {
  id          String          @id @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String          @db.VarChar(255)
  environment ApiKeyEnv       @default(LIVE) @map("environment")
  keyPrefix   String          @unique @map("key_prefix") @db.VarChar(16)
  keyHash     String          @map("key_hash") @db.VarChar(255)
  scopes      String[]
  status      ApiKeyStatus    @default(ACTIVE)
  expiresAt   DateTime?       @map("expires_at")
  lastUsedAt  DateTime?       @map("last_used_at")
  revokedAt   DateTime?       @map("revoked_at")
  revokedBy   String?         @map("revoked_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  companies   ApiKeyCompany[]
  auditLogs   AuditLog[]

  @@index([tenantId, status])
  @@index([keyPrefix])
  @@map("api_keys")
}

// ─── API KEY ↔ COMPANY (N:M) ───────────────────────────────────────────────

model ApiKeyCompany {
  apiKeyId  String  @map("api_key_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  apiKey    ApiKey  @relation(fields: [apiKeyId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@id([apiKeyId, companyId])
  @@map("api_key_companies")
}

// ─── REFRESH TOKENS ────────────────────────────────────────────────────────
// Stores hashed refresh tokens. On use, old token is marked used and a new one issued.

model RefreshToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────
// append-only: no UPDATE, no DELETE — enforced at application layer
// ADR-009: eventClass classifies retention requirement

model AuditLog {
  id            String     @id @db.Uuid
  tenantId      String?    @map("tenant_id") @db.Uuid
  companyId     String?    @map("company_id") @db.Uuid
  apiKeyId      String?    @map("api_key_id") @db.Uuid
  actor         String?    @db.VarChar(255) // userId | apiKeyPrefix | "system"
  action        String     @db.VarChar(255) // "api-key.created" | "user.login"
  resource      String?    @db.VarChar(255) // "ApiKey:uuid" | "Tenant:uuid"
  endpoint      String?    @db.VarChar(500)
  httpMethod    String?    @map("http_method") @db.VarChar(10)
  statusCode    Int?       @map("status_code")
  ipAddress     String?    @map("ip_address") @db.VarChar(45)
  correlationId String?    @map("correlation_id") @db.VarChar(36)
  durationMs    Int?       @map("duration_ms")
  eventClass    EventClass @default(TECHNICAL) @map("event_class")
  metadata      Json?
  errorMessage  String?    @map("error_message")
  createdAt     DateTime   @default(now()) @map("created_at")
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  apiKey        ApiKey?    @relation(fields: [apiKeyId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([eventClass, createdAt(sort: Desc)])
  @@map("audit_logs")
}
