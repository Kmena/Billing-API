{
  "name": "billing",
  "version": "0.1.0",
  "description": "Billing SaaS — Facturación Electrónica Costa Rica",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start:api": "node dist/bootstrap/api.main.js",
    "start:worker": "node dist/bootstrap/worker.main.js",
    "start:dev": "nest start --watch --entryFile bootstrap/api.main",
    "start:dev:worker": "nest start --watch --entryFile bootstrap/worker.main",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "test:hacienda-sandbox": "ts-node -r tsconfig-paths/register test/hacienda-sandbox/runner/f4s-runner.ts",
    "test:hacienda-sandbox:unit": "jest --config ./test/hacienda-sandbox/jest-f4s.json --passWithNoTests --runInBand",
    "f4s:bootstrap-signing-certificate": "ts-node -r tsconfig-paths/register scripts/f4s-bootstrap-signing-certificate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.623.0",
    "@aws-sdk/client-ssm": "^3.623.0",
    "@aws-sdk/s3-request-presigner": "^3.623.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.17.0",
    "@xmldom/xmldom": "^0.9.12",
    "argon2": "^0.40.3",
    "axios": "^1.20.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.1.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg-boss": "^10.1.3",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs/cache-manager|cache-manager|@nestjs/axios)/)"
    ],
    "moduleNameMapper": {
      "^@/modules/(.*)$": "<rootDir>/modules/$1",
      "^@/infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@/api/(.*)$": "<rootDir>/api/$1"
    }
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
